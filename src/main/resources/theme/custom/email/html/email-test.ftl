<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .email-container {
            max-width: 600px;
            margin: 20px auto;
            border: 1px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .header {
            background-color: #0052cc;
            color: white;
            text-align: center;
            padding: 20px;
            font-size: 24px;
        }
        .content {
            padding: 20px;
        }
        .footer {
            text-align: center;
            font-size: 12px;
            color: #666;
            padding: 10px;
            border-top: 1px solid #ddd;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            Email Test
        </div>
        <div class="content">
            <p>Hello,</p>
            <p>This is a test email to verify the SMTP configuration and email template functionality.</p>
            <p>Thank you,</p>
            <p><strong>Convonest Team</strong></p>
        </div>
        <div class="footer">
            <p>This email was sent as part of a test. No action is required.</p>
        </div>
    </div>
</body>
</html>
