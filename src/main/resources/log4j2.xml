<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <!-- Pattern includes date, level, logger name, thread, class name, line number, message, and full exception -->
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,UTC} [%thread] %-5p %c{36} (%F:%L) - %m%throwable{full}%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Configure logging level for your custom provider package -->
        <Logger name="com.convonest.keycloak" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- Root logger configuration -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
